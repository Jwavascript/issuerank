# 비밀값은 .env에만 입력합니다. 이 예시 파일에는 실제 키를 넣지 마세요.
# npm run api(로컬 API 단독 확인) 포트: 비워 두면 8787
# API_URL: 더 이상 쓰지 않음(BFF가 같은 프로세스에서 Hono 앱을 부름, D10). 이름만 남김
API_PORT=
API_URL=
# Supabase Transaction pooler(6543) 연결 문자열
DATABASE_URL=
NEWSDATA_API_KEY=
# OpenAI Platform에서 발급한 API 키(ChatGPT 로그인·구독과 별도)
OPENAI_API_KEY=

# 이메일·비밀번호 로그인: 32자 이상 무작위 비밀값과 앱 origin
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google 로그인(O2): Google Auth Platform › 클라이언트(웹 애플리케이션)의 클라이언트 ID · 보안 비밀번호.
# 둘 다 있어야 켜짐(하나라도 비면 "Google로 계속하기"는 "지금은 Google 로그인을 사용할 수 없습니다"). 로컬과 배포는 같은 DB라 로컬에서 로그인해도 실제 계정이 생김
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
