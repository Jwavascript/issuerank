# 비밀값은 .env에만 입력합니다. 이 예시 파일에는 실제 키를 넣지 마세요.
# npm run api(로컬 API 단독 확인) 포트: 비워 두면 8787
# API_URL: 더 이상 쓰지 않음(BFF가 같은 프로세스에서 Hono 앱을 부름, D10). 이름만 남김
API_PORT=
API_URL=
# Supabase Transaction pooler(6543) 연결 문자열
DATABASE_URL=
NEWSDATA_API_KEY=
# OpenAI Platform에서 발급한 API 키(ChatGPT 로그인·구독과 별도)
OPENAI_API_KEY=

# 이메일·비밀번호 로그인: 32자 이상 무작위 비밀값과 앱 origin
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
